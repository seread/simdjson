{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug cjson_test",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/benchmark/bench_ondemand",
            "args": [
                "--benchmark_filter=kostya",
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake Build",
            "internalConsoleOptions": "openOnSessionStart",
            "logging": {
                "trace": true,
                "traceResponse": true
            },
            "filterStderr": true,
            "filterStdout": true
        }
    ]
}